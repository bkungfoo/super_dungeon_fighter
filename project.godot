; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Super Dungeon Fighter"
config/description="Simultaneous-reveal tactical dungeon brawler. Heroes vs the Dark Lord."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/core/save_data.gd"
Session="*res://scripts/core/session.gd"
UI="*res://scripts/ui/ui_theme.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
